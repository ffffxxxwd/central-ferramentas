<!DOCTYPE html><html lang="pt-BR"><head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">

  <title>Central de Reembolsos 2 | WAM</title>
  <meta name="robots" content="noindex, nofollow">

  <link rel="apple-touch-icon" href="images/icon.webp">
  <link rel="icon" type="image/png" sizes="32x32" href="images/icon.webp">

  <link href="css/bootstrap.min.css" rel="stylesheet">
  <link href="css/sweetalert2.min.css" rel="stylesheet">
  <link rel="stylesheet" href="css/style.css">

  <style>
    /* ===== Ticket — comprovante estilo processamento ===== */
    .ticket {
      max-width: 460px;
      margin: 0 auto;
      background: #fff;
      border: 1px solid var(--borda);
      border-radius: 0.9rem;
      padding: 1.9rem 1.75rem 1.6rem;
    }

    .ticket__topo {
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding-bottom: 1.1rem;
      margin-bottom: 1.1rem;
      border-bottom: 1px solid var(--borda);
    }

    .ticket__logo { height: 30px; width: auto; }

    .ticket__icone {
      width: 62px;
      height: 62px;
      margin: 0.25rem auto 1.1rem;
      display: flex;
      align-items: center;
      justify-content: center;
      color: #fff;
      border-radius: 50%;
    }

    .ticket__eyebrow {
      text-align: center;
      font-size: 0.72rem;
      letter-spacing: 1.5px;
      text-transform: uppercase;
      font-weight: 700;
      color: var(--verde);
      margin: 0 0 0.3rem;
    }

    .ticket__titulo-sistema {
      text-align: center;
      font-weight: 700;
      font-size: 1.2rem;
      color: #1a1f22;
      margin: 0 0 1.4rem;
    }

    .ticket__protocolo {
      text-align: center;
      margin-bottom: 1.4rem;
    }

    .ticket__protocolo-label {
      display: block;
      font-size: 0.72rem;
      font-weight: 700;
      letter-spacing: 1.2px;
      text-transform: uppercase;
      color: var(--texto-suave);
      margin-bottom: 0.35rem;
    }

    .ticket__protocolo-valor {
      font-size: 1.9rem;
      font-weight: 700;
      color: var(--verde);
      letter-spacing: 0.5px;
    }

    .ticket__linhas { margin: 0; border-top: 1px dashed #d8dee2; }

    .ticket__linha {
      display: flex;
      flex-direction: column;
      gap: 0.3rem;
      padding: 0.75rem 0.15rem;
      border-bottom: 1px dashed #d8dee2;
    }

    .ticket__linha dt {
      color: var(--texto-suave);
      font-weight: 600;
      font-size: 0.72rem;
      letter-spacing: 0.6px;
      text-transform: uppercase;
      margin: 0;
    }

    .ticket__linha dd {
      color: #23282b;
      font-weight: 600;
      font-size: 1rem;
      margin: 0;
      display: flex;
      align-items: center;
      gap: 0.45rem;
      line-height: 1.4;
    }

    .ticket__linha-icone { flex: none; line-height: 0; }

    .ticket__rodape {
      margin: 1.2rem 0 0;
      padding: 0.85rem 1rem;
      background: var(--fundo-suave);
      border-radius: 0.6rem;
      color: #4a5258;
      font-size: 0.86rem;
      line-height: 1.45;
      text-align: center;
    }

    .ticket__cnpj {
      margin: 1rem 0 0;
      padding-top: 0.9rem;
      border-top: 1px solid var(--borda);
      text-align: center;
      font-size: 0.74rem;
      letter-spacing: 0.3px;
      color: #9aa1a7;
    }

    .reembolso-sucesso { max-width: 620px; margin: 0 auto; }

    /* ===== Modo de edição de textos ===== */
    .control-bar__editar { flex: none; white-space: nowrap; font-weight: 600; }
    .control-bar__editar.ativo {
      background: var(--verde);
      border-color: var(--verde);
      color: #fff;
    }

    .txt-edit.editavel {
      outline: 1px dashed #c2c9d0;
      outline-offset: 2px;
      border-radius: 3px;
      cursor: text;
      transition: outline-color .15s, background-color .15s;
    }
    .txt-edit.editavel:hover { outline-color: var(--verde); }
    .txt-edit.editavel:focus {
      outline: 2px solid var(--verde);
      background: #eef7ee;
    }
  </style>
</head>

<body>

  <!-- ===== Navbar (topo) ===== -->
  <nav class="navbar navbar-expand-lg site-nav sticky-top">
    <div class="container">
      <a class="navbar-brand" href="https://wamcancelamentos.com.br/">
        <img src="images/logo.png" alt="WAM" height="42">
      </a>
      <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#mainNav" aria-controls="mainNav" aria-expanded="false" aria-label="Menu">
        <span class="navbar-toggler-icon"></span>
      </button>
      <div class="collapse navbar-collapse" id="mainNav">
        <ul class="navbar-nav ms-auto mb-2 mb-lg-0">
          <li class="nav-item"><a class="nav-link" href="index.html">Reembolso 1</a></li>
          <li class="nav-item"><a class="nav-link active" aria-current="page" href="reembolso2.html">Reembolso 2</a></li>
        </ul>
      </div>
    </div>
  </nav>

  <!-- ===== Cabeçalho da página ===== -->
  <header class="page-hero">
    <div class="container">
      <span class="page-hero__eyebrow">Área administrativa</span>
      <h1 class="page-hero__title">Central de Reembolsos</h1>
      <p class="page-hero__text">Preencha os dados do cliente e o valor para emitir o comprovante de reembolso.</p>
    </div>
  </header>

  <!-- ===== Conteúdo ===== -->
  <main class="container main-wrap">
    <div class="panel">

      <form id="formReembolso" method="POST" autocomplete="off" novalidate="">
        <h2 class="panel__title">Dados do reembolso</h2>

        <div class="row">
          <div class="col-md-7 mb-3">
            <label for="cliente" class="form-label">Nome do cliente</label>
            <input type="text" class="form-control" name="cliente" id="cliente" placeholder="Nome completo do cliente" required="">
          </div>
          <div class="col-md-5 mb-3">
            <label for="cpf" class="form-label">CPF <span class="opcional">(opcional)</span></label>
            <input type="text" class="form-control" name="cpf" id="cpf" placeholder="000.000.000-00" inputmode="numeric">
          </div>
        </div>

        <div class="row">
          <div class="col-md-7 mb-3">
            <label for="empreendimento" class="form-label">Empreendimento <span class="opcional">(opcional)</span></label>
            <select class="form-select" name="empreendimento" id="empreendimento">
              <option value="">Selecione um empreendimento</option>
            </select>
          </div>
          <div class="col-md-5 mb-3">
            <label for="cota" class="form-label">Cota(s) <span class="opcional">(opcional)</span></label>
            <input type="text" class="form-control" name="cota" id="cota" placeholder="Informe a(s) cota(s)">
          </div>
        </div>

        <div class="row">
          <div class="col-md-5 mb-3">
            <label for="valor" class="form-label">Valor do reembolso</label>
            <div class="input-group">
              <span class="input-group-text">R$</span>
              <input type="text" class="form-control" name="valor" id="valor" placeholder="0,00" inputmode="numeric" required="">
            </div>
          </div>
          <div class="col-md-7 mb-3">
            <label for="forma" class="form-label">Forma de reembolso</label>
            <select class="form-select" name="forma" id="forma" required="">
              <option value="">Selecione a forma</option>
              <option value="PIX">PIX</option>
              <option value="Transferência bancária">Transferência bancária</option>
              <option value="Estorno no cartão">Estorno no cartão</option>
            </select>
          </div>
        </div>

        <!-- Campos condicionais: PIX -->
        <div class="row forma-campos" id="camposPix" hidden>
          <div class="col-md-12 mb-3">
            <label for="chavePix" class="form-label">Chave PIX</label>
            <input type="text" class="form-control" name="chavePix" id="chavePix" placeholder="CPF, e-mail, telefone ou chave aleatória">
          </div>
        </div>

        <!-- Campos condicionais: Transferência bancária -->
        <div class="row forma-campos" id="camposBanco" hidden>
          <div class="col-md-6 mb-3">
            <label for="banco" class="form-label">Banco</label>
            <input type="text" class="form-control" name="banco" id="banco" placeholder="Ex.: 341 - Itaú">
          </div>
          <div class="col-md-3 mb-3">
            <label for="agencia" class="form-label">Agência</label>
            <input type="text" class="form-control" name="agencia" id="agencia" placeholder="0000">
          </div>
          <div class="col-md-3 mb-3">
            <label for="conta" class="form-label">Conta</label>
            <input type="text" class="form-control" name="conta" id="conta" placeholder="00000-0">
          </div>
        </div>

        <div class="row">
          <div class="col-md-12 mb-3">
            <label for="protocolo" class="form-label">Protocolo de referência <span class="opcional">(opcional)</span></label>
            <input type="text" class="form-control" name="protocolo" id="protocolo" placeholder="Ex.: WAM-20260728-1234">
          </div>
        </div>

        <button type="submit" class="btn btn-success w-100 py-2 mt-2">
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" class="me-2" viewBox="0 0 16 16" aria-hidden="true">
            <polyline points="3 8 6 11 13 4" stroke-linecap="round" stroke-linejoin="round"></polyline>
          </svg>
          Efetivar Reembolso
        </button>
      </form>

      <!-- ===== Tela de sucesso / comprovante ===== -->
      <section id="reembolsoSucesso" class="reembolso-sucesso" hidden aria-live="polite">

        <!-- Barra de controle — FORA da área capturada -->
        <div class="control-bar no-capture">
          <div class="control-bar__status">
            <label for="status" class="control-bar__label">Status do reembolso</label>
            <select id="status" class="form-select">
              <optgroup label="Aprovado">
                <option value="Efetivado">Efetivado</option>
                <option value="Aprovado">Aprovado</option>
                <option value="Concluído">Concluído</option>
                <option value="Estornado">Estornado</option>
              </optgroup>
              <optgroup label="Em andamento">
                <option value="Em processamento">Em processamento</option>
                <option value="Em análise">Em análise</option>
                <option value="Pendente">Pendente</option>
              </optgroup>
              <optgroup label="Não aprovado">
                <option value="Bloqueado">Bloqueado</option>
                <option value="Negado">Negado</option>
                <option value="Cancelado">Cancelado</option>
              </optgroup>
            </select>
          </div>
          <button type="button" id="btnEditarTextos" class="btn btn-outline-secondary btn-sm control-bar__editar">
            <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" class="me-1" viewBox="0 0 24 24" aria-hidden="true">
              <path d="M12 20h9" stroke-linecap="round"></path>
              <path d="M16.5 3.5a2.1 2.1 0 0 1 3 3L7 19l-4 1 1-4z" stroke-linecap="round" stroke-linejoin="round"></path>
            </svg>
            Editar textos
          </button>
          <span class="control-bar__hint">Ative a edição e clique em qualquer texto do comprovante para alterá-lo. O status é definido pelo seletor; nada disto entra na captura.</span>
        </div>

        <!-- ÁREA CAPTURADA — formato ticket -->
        <div class="ticket" id="comprovante">
          <div class="ticket__topo">
            <img class="ticket__logo" src="data:image/png;base64," alt="WAM">
            <span class="status-badge" id="statusBadge">
              <span class="status-badge__dot"></span>
              <span id="tkStatusBadgeTexto">Efetivado</span>
            </span>
          </div>

          <div class="ticket__icone" id="tkIconeCirculo" aria-hidden="true"></div>

          <p class="ticket__eyebrow txt-edit">Central de Processamento Financeiro</p>
          <p class="ticket__titulo-sistema txt-edit">WAM</p>

          <div class="ticket__protocolo">
            <span class="ticket__protocolo-label txt-edit">Protocolo</span>
            <div class="ticket__protocolo-valor txt-edit" id="tkProtocolo">#845921</div>
          </div>

          <dl class="ticket__linhas">
            <div class="ticket__linha">
              <dt class="txt-edit">Solicitação</dt>
              <dd class="txt-edit">Reembolso</dd>
            </div>
            <div class="ticket__linha">
              <dt class="txt-edit">Status atual</dt>
              <dd>
                <span class="ticket__linha-icone" id="tkStatusIconeSvg"></span>
                <span class="txt-edit" id="tkStatusTexto">Bloqueado</span>
              </dd>
            </div>
            <div class="ticket__linha">
              <dt class="txt-edit">Origem da ocorrência</dt>
              <dd class="txt-edit" id="tkOrigem">Falha técnica no sistema de pagamentos.</dd>
            </div>
            <div class="ticket__linha">
              <dt class="txt-edit">Fluxo operacional disponível</dt>
              <dd>
                <span class="ticket__linha-icone" id="tkFluxoIconeSvg"></span>
                <span class="txt-edit" id="tkFluxo">Procedimento de Regularização Financeira</span>
              </dd>
            </div>
          </dl>

          <p class="ticket__rodape txt-edit" id="tkRodape">Aguardando execução do procedimento.</p>

          <p class="ticket__cnpj txt-edit">WAM · CNPJ 03.774.432/0002-29</p>
        </div>

        <!-- Ações — FORA da área capturada -->
        <div class="comprovante__acoes no-capture">
          <button type="button" id="btnCapturar" class="btn btn-success">
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" class="me-2" viewBox="0 0 24 24" aria-hidden="true">
              <path d="M23 19a2 2 0 0 1-2 2H3a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h4l2-3h6l2 3h4a2 2 0 0 1 2 2z" stroke-linecap="round" stroke-linejoin="round"></path>
              <circle cx="12" cy="13" r="4"></circle>
            </svg>
            Capturar e copiar
          </button>
          <button type="button" id="btnImprimir" class="btn btn-outline-success">
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" class="me-2" viewBox="0 0 24 24" aria-hidden="true">
              <polyline points="6 9 6 2 18 2 18 9" stroke-linecap="round" stroke-linejoin="round"></polyline>
              <path d="M6 18H4a2 2 0 0 1-2-2v-5a2 2 0 0 1 2-2h16a2 2 0 0 1 2 2v5a2 2 0 0 1-2 2h-2" stroke-linecap="round" stroke-linejoin="round"></path>
              <rect x="6" y="14" width="12" height="8" rx="1"></rect>
            </svg>
            Imprimir
          </button>
          <button type="button" id="btnNovo" class="btn btn-light">Novo reembolso</button>
        </div>
      </section>

    </div>
  </main>

  <!-- ===== Rodapé ===== -->
  <footer class="site-footer">
    <div class="container">
      <p class="site-footer__brand"><strong>ALLHANDS LTDA</strong> · CNPJ 49.536.206/0001-20</p>
      <p class="site-footer__brand"><strong>WAM</strong> · CNPJ 03.774.432/0002-29</p>
      <p><a href="mailto:contato@wamcancelamentos.com.br">contato@wamcancelamentos.com.br</a> · (62) 3142-5009</p>
      <p class="site-footer__note">Uso interno — ferramenta de emissão de comprovante de reembolso.</p>
    </div>
  </footer>

  <script src="js/jquery-3.4.1.min.js"></script>
  <script src="js/bootstrap.bundle.min.js"></script>
  <script src="js/jquery.validate.min.js"></script>
  <script src="js/additional-methods.min.js"></script>
  <script src="js/jquery.mask.min.js"></script>
  <script src="js/sweetalert2.all.min.js"></script>
  <script src="js/html2canvas.min.js"></script>
  <script src="js/app2.js"></script>

</body></html>
